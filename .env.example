# SPDX-License-Identifier: AGPL-3.0-only
# Copy to .env and edit. Only WORKER is required.

# ssh destinations of the other three Sparks (space-separated, in any order:
# the cables decide the ranks). Passwordless ssh, and each user can run docker.
# An address on a direct cable makes the one-time copy of the weights much faster.
WORKER="you@spark-b you@spark-c you@spark-d"

# Sparks serving together. Four is the only number served so far: three need
# the weights split three ways, which the pinned engine does not have yet.
#SPARKS=4

# Tokens the release's draft head proposes each step, for the model to check
# (0 to 15). 0 turns the draft head off.
#DRAFTS=5

# Rows a prefill pass runs together: 8192 or 16384.
#PREFILL_ROWS=8192

# The longest sequence (prompt and reply) in tokens, up to the model's 1048576.
#CONTEXT=131072

# The API's port on this Spark (rank 0). Rank R also listens on PORT + R, on
# its own loopback.
#PORT=8894

# Where the checkpoint is downloaded (about 510 GB), at the same absolute path
# on every Spark. Default: $HOME/models/sparkseek
#MODEL_ROOT=/srv/models/sparkseek

# A copy of deepseek-ai/DeepSeek-V4.1-Flash-1017 that every Spark already has,
# at this same absolute path (the directory that holds config.json). Nothing is
# downloaded or copied then, and MODEL_ROOT is not used.
#CHECKPOINT_DIR=/srv/models/DeepSeek-V4.1-Flash-1017

# Build the image from source even when ghcr.io/enntity/atlas-sparkseek has it.
#BUILD=1
# Parallel compile jobs for a source build (default: one per ~10 GiB of free
# memory, at most half the cores); lower it if the build runs out of memory.
#ATLAS_BUILD_JOBS=4
# Skip the engine's unit tests during the build (default 1: run them) for an
# engine commit that already passed them; the image is the same either way.
#ATLAS_IMAGE_CHECKS=0

# Only for private Hugging Face mirrors; the pinned checkpoint is public.
#HF_TOKEN=

# GPU clock cap. ./start.sh clock-cap installs gpu-clock-cap.service on every
# Spark (sudo), which locks the GPU clock to 300..GPU_CLOCK_MAX_MHZ at every
# boot. Uncapped, a long cold prefill can power a Spark off. ./start.sh refuses
# to serve until every Spark runs it; CLOCK_CAP=0 skips that check.
#GPU_CLOCK_MAX_MHZ=2200
#CLOCK_CAP=0
